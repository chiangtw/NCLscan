#! /usr/bin/env python

"""
# Create index
## create indexes and "refs.cfg"

NCLscan index
    -r/--ref_dir REF_DIR
    -g/--genome GENOME
    -a/--gtf GTF
    -c/--pc_transcripts PC_TRANSCRIPTS
    -l/--lnc_transcripts LNC_TRANSCRIPTS


# Run

NCLscan run
    -r/--ref_dir REF_DIR
    -1 FASTQ_1(.gz)
    -2 FASTQ_2(.gz)
    -P/--name_prefix NAME_PREFIX
    -o/--out_dir OUT_DIR
    -t THREADS ("10" or "bwa=10,blat=4")
"""

from __future__ import print_function

import argparse
import subprocess as sp
import sys
import os
import os.path
import tempfile as tp
import re

if sys.version_info[0] == 2:
    import ConfigParser as configparser
else:
    import configparser

import logging
from contextlib import contextmanager
from collections import defaultdict

logging.basicConfig(
    level=logging.INFO,
    format='[%(asctime)s] %(message)s'
)

class NCLscanVirtualConfig(object):
    def __init__(self):
        self.init_config()

    def init_config(self):
        self.option_values = {
            'NCLscan_ref_dir': '',
            'Reference_genome': '',
            'Gene_annotation': '',
            'Protein_coding_transcripts': '',
            'lncRNA_transcripts': '',
            'bedtools_bin': 'bedtools',
            'blat_bin': 'blat',
            'bwa_bin': 'bwa',
            'samtools_bin': 'samtools',
            'novoalign_bin': 'novoalign',
            'novoindex_bin': 'novoindex',
            'Add_read_count_bin': 'Add_read_count.py',
            'AssembleExons_bin': 'AssembleExons',
            'AssembleFastq_bin': 'AssembleFastq',
            'AssembleJSeq_bin': 'AssembleJSeq.py',
            'append_Z3_tag': 'append_Z3_tag.py',
            'FastqOut_bin': 'FastqOut',
            'get_gene_name_bin': 'get_gene_name.py',
            'GetInfo_bin': 'GetInfo',
            'GetKey_bin': 'GetKey',
            'GetNameB4Dot_bin': 'GetNameB4Dot',
            'InsertInList_bin': 'InsertInList',
            'JSFilter_bin': 'JSFilter',
            'JSParser_bin': 'JSParser',
            'JunctionSite2BED_bin': 'JunctionSite2BED',
            'mp_blat_bin': 'mp_blat.py',
            'PslChimeraFilter_bin': 'PslChimeraFilter',
            'RemoveInList_bin': 'RemoveInList',
            'RetainInList_bin': 'RetainInList',
            'RmBadMapping_bin': 'RmBadMapping',
            'RmColinearPairInSam_bin': 'RmColinearPairInSam',
            'RmRedundance_bin': 'RmRedundance',
            'SeqOut_bin': 'SeqOut',
            'max_read_len': '151',
            'max_fragment_size': '500',
            'quality_score': '20',
            'span_range': '50',
            'bwa-mem-t': '1',
            'mp_blat_process': '1',
        }

    def update(self, other):
        self.option_values.update(other)

    @contextmanager
    def create_virtual_config(self):
        with tp.NamedTemporaryFile(prefix='NCLscan') as config_file:
            config = configparser.ConfigParser()
            config.optionxform = str
            config.add_section('NCLscan_config')

            for k, v in self.option_values.items():
                config.set('NCLscan_config', k, v)

            with open(config_file.name, 'w') as out:
                config.write(out)

            yield config_file.name


class RefsConfig(object):

    @staticmethod
    def create(filename, refs_dict):
        config = configparser.ConfigParser()
        config.add_section('refs')

        for k, v in refs_dict.items():
            config.set('refs', k, v)

        with open(filename, 'w') as out:
            config.write(out)

    @staticmethod
    def load(filename):
        config = configparser.ConfigParser()
        config.read(filename)
        refs_dict = dict(config.items('refs'))
        return refs_dict


def makedirs(dir_path, exist_ok=False):
    if exist_ok:
        if not os.path.exists(dir_path):
            os.makedirs(dir_path)
    else:
        os.makedirs(dir_path)


def subprocess_run(cmd):
    p = sp.Popen(cmd, stdout=sp.PIPE, stderr=sp.STDOUT)

    try:
        for line in iter(p.stdout.readline, b''):
            print(line, end='', file=sys.stderr)

        p.wait()

    finally:
        p.terminate()


def index_mode(args):
    logging.info('test logging')

    # create 'refs.cfg'
    refs_dict = {
        'genome': os.path.abspath(args.genome),
        'gtf': os.path.abspath(args.gtf),
        'pc_transcripts': os.path.abspath(args.pc_transcripts),
        'lnc_transcripts': os.path.abspath(args.lnc_transcripts),
    }
    makedirs(args.ref_dir, exist_ok=True)
    ref_cfg = os.path.join(args.ref_dir, 'refs.cfg')
    RefsConfig.create(ref_cfg, refs_dict)

    # create indexes for NCLscan
    config = NCLscanVirtualConfig()
    config.update(
        {
            'NCLscan_ref_dir': os.path.abspath(args.ref_dir),
            'Reference_genome': refs_dict['genome'],
            'Gene_annotation': refs_dict['gtf'],
            'Protein_coding_transcripts': refs_dict['pc_transcripts'],
            'lncRNA_transcripts': refs_dict['lnc_transcripts'],
        }
    )

    with config.create_virtual_config() as config:
        cmd = ['create_reference.py', '-c', config]
        result = subprocess_run(cmd)
        return result


def parse_threads(thread_str):
    if '=' in thread_str:
        thread_options = dict(re.findall(r'(\w+)\s*=\s*(\d+)', thread_str))
    else:
        thread_str = re.search(r'\s*(\d+)\s*', thread_str).group(1)
        thread_options = defaultdict(lambda: thread_str)

    return thread_options


def run_mode(args):
    ref_cfg = os.path.join(args.ref_dir, 'refs.cfg')
    refs_dict = RefsConfig.load(ref_cfg)

    thread_options = parse_threads(args.threads)

    config = NCLscanVirtualConfig()
    config.update(
        {
            'NCLscan_ref_dir': os.path.abspath(args.ref_dir),
            'Reference_genome': refs_dict['genome'],
            'Gene_annotation': refs_dict['gtf'],
            'Protein_coding_transcripts': refs_dict['pc_transcripts'],
            'lncRNA_transcripts': refs_dict['lnc_transcripts'],
            'bwa-mem-t': thread_options['bwa'],
            'mp_blat_process': thread_options['blat'],
        }
    )

    with config.create_virtual_config() as config:
        cmd = [
            'NCLscan.py',
            '-c', config,
            '--fq1', args.fastq1,
            '--fq2', args.fastq2,
            '-pj', args.name_prefix,
            '-o', args.out_dir,
        ]

        result = subprocess_run(cmd)

        return result


def create_parser():

    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest='mode', help='sub-commands')

    index_mode_parser = subparsers.add_parser('index', help='create index files for NCLscan')
    index_mode_parser.add_argument('-r', '--ref_dir')
    index_mode_parser.add_argument('-g', '--genome')
    index_mode_parser.add_argument('-a', '--gtf')
    index_mode_parser.add_argument('-c', '--pc_transcripts')
    index_mode_parser.add_argument('-l', '--lnc_transcripts')
    index_mode_parser.set_defaults(func=index_mode)

    run_mode_parser = subparsers.add_parser('run', help='run NCLscan')
    run_mode_parser.add_argument('-r', '--ref_dir')
    run_mode_parser.add_argument('-1', '--fastq1')
    run_mode_parser.add_argument('-2', '--fastq2')
    run_mode_parser.add_argument('-P', '--name_prefix')
    run_mode_parser.add_argument('-o', '--out_dir')
    run_mode_parser.add_argument('-t', '--threads', default=1, help='e.g. 10 or \'bwa=10,blat=5\'')
    run_mode_parser.set_defaults(func=run_mode)

    return parser


if __name__ == "__main__":
    parser = create_parser()
    args = parser.parse_args()
    args.func(args)
